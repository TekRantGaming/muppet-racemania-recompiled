#include <winver.h>

1 ICON "launcher.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PROJECT_VERSION_COMMAS
PRODUCTVERSION PROJECT_VERSION_COMMAS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904B0"
    BEGIN
      VALUE "CompanyName", "TekRantGaming"
      VALUE "FileDescription", "Muppet RaceMania Recompiled"
      VALUE "FileVersion", PROJECT_VERSION
      VALUE "ProductName", "Muppet RaceMania Recompiled"
      VALUE "ProductVersion", PROJECT_VERSION
      VALUE "OriginalFilename", "MuppetRaceMania.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0809, 1200
  END
END
